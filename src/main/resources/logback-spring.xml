<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0017 (Onda 1): console no formato padrão do Spring Boot (legível em dev),
  mas com a mesma máscara de e-mail/JWT do arquivo (S09/ADR-0019); arquivo em JSON (um evento por linha), com rotação diária e
  retenção de 7 dias, pra investigação manual via SSH em produção.
  Diretório configurável por LOG_PATH (padrão: ./logs).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- S09: mesmo padrão do console do Spring Boot (sem cores), mas a mensagem e o stack trace passam
         pela máscara de e-mail e JWT — as mensagens de exceção de terceiros (ex: violação de unique do
         Postgres: "Key (email)=(x@y.com)") não saem em claro no console. -->
    <property name="EMAIL_REGEX" value="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"/>
    <property name="JWT_REGEX" value="eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"/>
    <property name="MASKED_MESSAGE" value="%replace(%replace(%m){'${EMAIL_REGEX}','***@***'}){'${JWT_REGEX}','***'}"/>
    <property name="MASKED_EXCEPTION" value="%replace(%replace(%wEx){'${EMAIL_REGEX}','***@***'}){'${JWT_REGEX}','***'}"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}} %5p ${PID:- } --- [%15.15t] %-40.40logger{39} : ${MASKED_MESSAGE}%n${MASKED_EXCEPTION}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <property name="LOG_DIR" value="${LOG_PATH:-logs}"/>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/shottrack-backend.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/shottrack-backend.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- ADR-0019: e-mail e tokens nunca vão pro arquivo de log, nem dentro de
                 mensagens de exceção de terceiros (ex: violação de unique do Postgres) -->
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMask>
                    <value>[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}</value>
                    <mask>***@***</mask>
                </valueMask>
                <valueMask>
                    <value>eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+</value>
                    <mask>***</mask>
                </valueMask>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>
