<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0017 (Onda 1): console continua no formato padrão do Spring Boot (legível
  em dev); arquivo em JSON (um evento por linha), com rotação diária e
  retenção de 7 dias, pra investigação manual via SSH em produção.
  Diretório configurável por LOG_PATH (padrão: ./logs).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <property name="LOG_DIR" value="${LOG_PATH:-logs}"/>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/shottrack-backend.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/shottrack-backend.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- ADR-0019: e-mail e tokens nunca vão pro arquivo de log, nem dentro de
                 mensagens de exceção de terceiros (ex: violação de unique do Postgres) -->
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMask>
                    <value>[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}</value>
                    <mask>***@***</mask>
                </valueMask>
                <valueMask>
                    <value>eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+</value>
                    <mask>***</mask>
                </valueMask>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>
